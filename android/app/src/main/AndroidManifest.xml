<?xml version="1.0" encoding="utf-8"?>
<!-- 轻提醒 · 安卓版
     权限只保留提醒必需的几项：没有任何联网权限，程序无法也不会上传数据。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 到点发通知（Android 13+ 需要用户授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟（Android 12+ 需要单独授权，否则只能近似时间） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 重启后重新排程，否则关机一次提醒就全没了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 引导用户把本应用排除在省电优化之外（提醒类应用的正当用途） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".QtxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.QingTiXing">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QingTiXing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 到点触发：发通知 + 排下一次 -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 稍后提醒：通知上的按钮 -->
        <receiver
            android:name=".alarm.SnoozeReceiver"
            android:exported="false" />

        <!-- 开机 / 改时间 / 应用更新后重新排程 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
