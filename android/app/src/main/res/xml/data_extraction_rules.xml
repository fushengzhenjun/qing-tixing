<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份 / 换机迁移规则 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="reminders.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="reminders.json" />
    </device-transfer>
</data-extraction-rules>
